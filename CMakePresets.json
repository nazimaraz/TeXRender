{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "headless-debug",
      "displayName": "Headless Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/headless-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TEXRENDER_BACKEND": "headless",
        "TEXRENDER_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "headless-release",
      "displayName": "Headless Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/headless-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TEXRENDER_BACKEND": "headless"
      }
    },
    {
      "name": "raylib-release",
      "displayName": "Raylib Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/raylib-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TEXRENDER_BACKEND": "raylib"
      }
    },
    {
      "name": "headless-shared",
      "displayName": "Headless Shared Library",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/headless-shared",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "TEXRENDER_BACKEND": "headless"
      }
    },
    {
      "name": "svg-release",
      "displayName": "SVG Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/svg-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TEXRENDER_BACKEND": "svg"
      }
    },
    {
      "name": "sdl2-release",
      "displayName": "SDL2 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/sdl2-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TEXRENDER_BACKEND": "sdl2"
      }
    },
    {
      "name": "asan",
      "displayName": "Headless ASan + UBSan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "TEXRENDER_BACKEND": "headless"
      }
    },
    {
      "name": "tsan",
      "displayName": "Headless ThreadSanitizer",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "TEXRENDER_BACKEND": "headless",
        "TEXRENDER_BUILD_EXAMPLES": "OFF",
        "TEXRENDER_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "coverage",
      "displayName": "Headless Coverage",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "--coverage -O0 -g",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage",
        "TEXRENDER_BACKEND": "headless"
      }
    },
    {
      "name": "fuzz",
      "displayName": "try_render libFuzzer",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/fuzz",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang++",
        "TEXRENDER_BACKEND": "headless",
        "TEXRENDER_BUILD_BENCHMARKS": "OFF",
        "TEXRENDER_BUILD_EXAMPLES": "OFF",
        "TEXRENDER_BUILD_FUZZERS": "ON",
        "TEXRENDER_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "headless-debug",
      "configurePreset": "headless-debug"
    },
    {
      "name": "headless-release",
      "configurePreset": "headless-release"
    },
    {
      "name": "raylib-release",
      "configurePreset": "raylib-release"
    },
    {
      "name": "headless-shared",
      "configurePreset": "headless-shared"
    },
    {
      "name": "svg-release",
      "configurePreset": "svg-release"
    },
    {
      "name": "sdl2-release",
      "configurePreset": "sdl2-release"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "targets": ["texrender_try_render_fuzzer"]
    }
  ],
  "testPresets": [
    {
      "name": "headless-debug",
      "configurePreset": "headless-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "headless-release",
      "configurePreset": "headless-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "raylib-release",
      "configurePreset": "raylib-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "headless-shared",
      "configurePreset": "headless-shared",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "svg-release",
      "configurePreset": "svg-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sdl2-release",
      "configurePreset": "sdl2-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0",
        "UBSAN_OPTIONS": "print_stacktrace=1"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
