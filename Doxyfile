PROJECT_NAME           = "TeXRender"
PROJECT_BRIEF          = "C++ LaTeX math renderer with raylib, SDL2, headless RGBA, and SVG backends"
PROJECT_NUMBER         = 0.1.0

OUTPUT_DIRECTORY       = build-api-docs
CREATE_SUBDIRS         = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = api
GENERATE_LATEX         = NO
GENERATE_XML           = NO

INPUT                  = include \
                         SECURITY.md \
                         THIRD_PARTY.md \
                         docs/api-mainpage.md \
                         docs/getting-started-api.md \
                         docs/api.md \
                         docs/architecture.md \
                         docs/backend-authoring.md \
                         docs/known-limitations.md \
                         docs/examples-index.md \
                         docs/integration-examples.md \
                         docs/recipes.md \
                         docs/why-not-just-tex.md \
                         docs/api-compatibility.md \
                         docs/public-api-snapshot.txt \
                         docs/security-threat-model.md \
                         docs/dependency-license-audit.md \
                         docs/upstream-microtex-patch.md \
                         docs/migration.md \
                         docs/gallery.md \
                         docs/github-launch.md \
                         docs/first-public-push-dry-run.md \
                         docs/local-release-rehearsal.md \
                         docs/release-body-v0.1.0.md \
                         docs/release-assets.md \
                         docs/release-checklist.md \
                         docs/package-publishing.md \
                         docs/registry-submissions.md \
                         docs/release-notes-v0.1.0.md \
                         docs/resume.md \
                         docs/support-matrix.md \
                         docs/benchmarks.md \
                         docs/fuzzing.md \
                         docs/performance-baseline.md \
                         docs/performance-baseline.json \
                         docs/build-options.md \
                         docs/static-analysis.md \
                         docs/coverage.md \
                         docs/workflow-linting.md \
                         docs/roadmap.md \
                         docs/case-study.md
FILE_PATTERNS          = *.hpp *.md *.json
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = docs/api-mainpage.md
EXAMPLE_PATH           = .

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS

GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES
HTML_DYNAMIC_SECTIONS  = YES

HAVE_DOT               = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
DOT_IMAGE_FORMAT       = svg
