PROJECT_NAME           = "texgui"
PROJECT_BRIEF          = "C++ LaTeX math renderer with raylib, headless RGBA, and SVG backends"
PROJECT_NUMBER         = 0.1.0

OUTPUT_DIRECTORY       = build-api-docs
CREATE_SUBDIRS         = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = api
GENERATE_LATEX         = NO
GENERATE_XML           = NO

INPUT                  = include \
                         docs/api-mainpage.md \
                         docs/api.md \
                         docs/architecture.md \
                         docs/known-limitations.md \
                         docs/integration-examples.md \
                         docs/api-compatibility.md \
                         docs/gallery.md \
                         docs/package-publishing.md \
                         docs/benchmarks.md \
                         docs/fuzzing.md \
                         docs/performance-baseline.md \
                         docs/build-options.md \
                         docs/static-analysis.md \
                         docs/coverage.md \
                         docs/workflow-linting.md \
                         docs/roadmap.md \
                         docs/case-study.md
FILE_PATTERNS          = *.hpp *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = docs/api-mainpage.md

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS

GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES
HTML_DYNAMIC_SECTIONS  = YES

HAVE_DOT               = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
DOT_IMAGE_FORMAT       = svg
