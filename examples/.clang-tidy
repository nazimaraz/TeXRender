---
# Examples are standalone demo programs, not reusable library code. They inherit
# the root .clang-tidy but relax a few checks that target library APIs: a demo
# main() may throw, and example I/O may ignore write return values or use C
# arrays. The shipped library under source/ keeps all of these enabled.
InheritParentConfig: true
Checks: >
  -bugprone-exception-escape,
  -cert-err33-c,
  -cppcoreguidelines-avoid-c-arrays,
  -modernize-avoid-c-arrays,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-type-reinterpret-cast
