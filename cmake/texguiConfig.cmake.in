@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(texgui_BACKEND "@TEXGUI_BACKEND@")
set(texgui_HAS_HEADLESS TRUE)
set(texgui_HAS_SVG TRUE)
set(texgui_HAS_RAYLIB @TEXGUI_HAS_RAYLIB_CMAKE@)
set(texgui_HAS_SDL2 @TEXGUI_HAS_SDL2_CMAKE@)

set(texgui_headless_FOUND TRUE)
set(texgui_svg_FOUND TRUE)
set(texgui_raylib_FOUND @TEXGUI_HAS_RAYLIB_CMAKE@)
set(texgui_sdl2_FOUND @TEXGUI_HAS_SDL2_CMAKE@)

foreach(_texgui_component IN LISTS texgui_FIND_COMPONENTS)
    if(NOT _texgui_component MATCHES "^(headless|svg|raylib|sdl2)$")
        set(texgui_${_texgui_component}_FOUND FALSE)
        if(texgui_FIND_REQUIRED_${_texgui_component})
            set(texgui_NOT_FOUND_MESSAGE
                "Unsupported texgui component '${_texgui_component}'. Supported components: headless, svg, raylib, sdl2.")
        endif()
    elseif(NOT texgui_${_texgui_component}_FOUND AND texgui_FIND_REQUIRED_${_texgui_component})
        set(texgui_NOT_FOUND_MESSAGE
            "texgui was built with backend '${texgui_BACKEND}' and does not provide requested component '${_texgui_component}'.")
    endif()
endforeach()

find_dependency(Freetype)
find_dependency(tinyxml2 CONFIG)
if("@TEXGUI_BACKEND@" STREQUAL "raylib")
    find_dependency(raylib)
elseif("@TEXGUI_BACKEND@" STREQUAL "sdl2")
    find_dependency(SDL2)
endif()

set_and_check(TEXGUI_RESOURCE_DIR "@PACKAGE_TEXGUI_INSTALL_RESDIR@")

include("${CMAKE_CURRENT_LIST_DIR}/texguiHelpers.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/texguiTargets.cmake")

check_required_components(texgui)
