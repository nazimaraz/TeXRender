prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@
resdir=${prefix}/@TEXRENDER_INSTALL_RESDIR@

Name: texrender
Description: @PROJECT_DESCRIPTION@
Version: @PROJECT_VERSION@
Requires.private: @TEXRENDER_PKG_CONFIG_REQUIRES_PRIVATE@
Libs: -L${libdir} -ltexrender -lmicrotex_core@TEXRENDER_PKG_CONFIG_LINK_FLAGS@
Cflags: -I${includedir}
