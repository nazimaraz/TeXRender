include("${CMAKE_CURRENT_LIST_DIR}/dependencies/DependencyHelpers.cmake")
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/dependencies")
find_package(TinyXML2 REQUIRED)
find_package(Freetype REQUIRED)
if (TEXRENDER_BACKEND STREQUAL "raylib")
    find_package(Raylib REQUIRED)
endif ()
if (TEXRENDER_BACKEND STREQUAL "sdl2")
    find_package(SDL2 REQUIRED)
endif ()
if (TEXRENDER_BACKEND STREQUAL "imgui")
    find_package(ImGui REQUIRED)
    # The ImGui examples drive the library through ImGui's SDL2 platform/renderer backends.
    if (TEXRENDER_BUILD_EXAMPLES)
        find_package(SDL2 REQUIRED)
    endif ()
endif ()
find_package(MicroTeX REQUIRED)
