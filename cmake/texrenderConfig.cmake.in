@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(texrender_BACKEND "@TEXRENDER_BACKEND@")
set(texrender_HAS_HEADLESS TRUE)
set(texrender_HAS_SVG TRUE)
set(texrender_HAS_RAYLIB @TEXRENDER_HAS_RAYLIB_CMAKE@)
set(texrender_HAS_SDL2 @TEXRENDER_HAS_SDL2_CMAKE@)

set(texrender_headless_FOUND TRUE)
set(texrender_svg_FOUND TRUE)
set(texrender_raylib_FOUND @TEXRENDER_HAS_RAYLIB_CMAKE@)
set(texrender_sdl2_FOUND @TEXRENDER_HAS_SDL2_CMAKE@)

foreach(_texrender_component IN LISTS texrender_FIND_COMPONENTS)
    if(NOT _texrender_component MATCHES "^(headless|svg|raylib|sdl2)$")
        set(texrender_${_texrender_component}_FOUND FALSE)
        if(texrender_FIND_REQUIRED_${_texrender_component})
            set(texrender_NOT_FOUND_MESSAGE
                "Unsupported texrender component '${_texrender_component}'. Supported components: headless, svg, raylib, sdl2.")
        endif()
    elseif(NOT texrender_${_texrender_component}_FOUND AND texrender_FIND_REQUIRED_${_texrender_component})
        set(texrender_NOT_FOUND_MESSAGE
            "texrender was built with backend '${texrender_BACKEND}' and does not provide requested component '${_texrender_component}'.")
    endif()
endforeach()

find_dependency(Freetype)
find_dependency(tinyxml2 CONFIG)
if("@TEXRENDER_BACKEND@" STREQUAL "raylib")
    find_dependency(raylib)
elseif("@TEXRENDER_BACKEND@" STREQUAL "sdl2")
    find_dependency(SDL2)
endif()

set_and_check(TEXRENDER_RESOURCE_DIR "@PACKAGE_TEXRENDER_INSTALL_RESDIR@")

include("${CMAKE_CURRENT_LIST_DIR}/texrenderHelpers.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/texrenderTargets.cmake")

check_required_components(texrender)
