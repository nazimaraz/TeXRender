#pragma once

/// Backend selected when this texgui target/package was built.
///
/// Values currently include `headless`, `svg`, `raylib`, and `sdl2`.
#define TEXGUI_BACKEND_NAME "@TEXGUI_BACKEND@"

/// Backend-neutral software RGBA surface support is always available.
#define TEXGUI_HAS_HEADLESS @TEXGUI_HAS_HEADLESS@
/// Backend-neutral SVG export surface support is always available.
#define TEXGUI_HAS_SVG @TEXGUI_HAS_SVG@
/// raylib surface support is available only in raylib builds/packages.
#define TEXGUI_HAS_RAYLIB @TEXGUI_HAS_RAYLIB@
/// SDL2 surface support is available only in SDL2 builds/packages.
#define TEXGUI_HAS_SDL2 @TEXGUI_HAS_SDL2@

namespace TexGui
{
    /// Backend selected when this texgui target/package was built.
    ///
    /// Useful in portable examples, logs, and package-manager smoke tests.
    inline constexpr const char* build_backend = TEXGUI_BACKEND_NAME;
    /// Whether `HeadlessSurface` is compiled into this target/package.
    inline constexpr bool has_headless = TEXGUI_HAS_HEADLESS != 0;
    /// Whether `SvgSurface` is compiled into this target/package.
    inline constexpr bool has_svg = TEXGUI_HAS_SVG != 0;
    /// Whether `RaylibSurface` is compiled into this target/package.
    inline constexpr bool has_raylib = TEXGUI_HAS_RAYLIB != 0;
    /// Whether `Sdl2Surface` is compiled into this target/package.
    inline constexpr bool has_sdl2 = TEXGUI_HAS_SDL2 != 0;
} // namespace TexGui
